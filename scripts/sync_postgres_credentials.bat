@echo off
setlocal EnableExtensions DisableDelayedExpansion
cd /d "%~dp0\.."

if not defined OTP_DB_PASSWORD (
  echo [INFO] OTP_DB_PASSWORD is not yet loaded. Loading release secrets from .env...
  call scripts\load_compose_secrets.bat
  if errorlevel 1 (
    echo [ERROR] Could not load OTP_DB_PASSWORD from .env.
    exit /b 1
  )
)

if not defined OTP_DB_PASSWORD (
  echo [ERROR] OTP_DB_PASSWORD is unavailable after loading .env.
  exit /b 1
)

if not exist logs mkdir logs
set "PG_PREFLIGHT_LOG=logs\postgres_preflight.log"
> "%PG_PREFLIGHT_LOG%" echo PostgreSQL credential preflight - %date% %time%

rem Start PostgreSQL alone. A fresh official image briefly starts a temporary
rem initialization server; pg_isready can succeed before POSTGRES_DB is created.
rem Therefore wait for a real SQL statement against the always-present postgres DB.
echo [INFO] Starting PostgreSQL preflight...
docker compose up -d otp-postgres >> "%PG_PREFLIGHT_LOG%" 2>&1
if errorlevel 1 (
  echo [ERROR] PostgreSQL container could not be started.
  echo [ACTION] See %PG_PREFLIGHT_LOG%.
  exit /b 2
)

set "PG_SQL_READY="
for /L %%I in (1,1,60) do (
  docker compose exec -T otp-postgres psql -U otp -d postgres -v ON_ERROR_STOP=1 -tAc "SELECT 1" >> "%PG_PREFLIGHT_LOG%" 2>&1
  if not errorlevel 1 (
    set "PG_SQL_READY=1"
    goto :sql_ready
  )
  powershell -NoProfile -Command "Start-Sleep -Seconds 2" >nul 2>&1
)

:sql_ready
if not defined PG_SQL_READY (
  echo [ERROR] PostgreSQL did not become SQL-ready within 120 seconds.
  echo [ACTION] Review %PG_PREFLIGHT_LOG% and the PostgreSQL diagnostics below.
  docker compose logs --tail=120 otp-postgres
  exit /b 3
)

echo [INFO] PostgreSQL is SQL-ready. Synchronizing application credentials...

rem Use a temporary SQL file so the password is not parsed by cmd delayed expansion.
rem Passwords generated by this release are hex-only, but this also avoids future shell quoting regressions.
set "PG_SQL_FILE=logs\sync_postgres_role.sql"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$p=$env:OTP_DB_PASSWORD.Replace('''',''''''); Set-Content -LiteralPath '%PG_SQL_FILE%' -Encoding ASCII -Value ('ALTER ROLE otp WITH PASSWORD ''' + $p + ''';')" >> "%PG_PREFLIGHT_LOG%" 2>&1
if errorlevel 1 (
  echo [ERROR] Could not prepare the PostgreSQL credential synchronization command.
  echo [ACTION] See %PG_PREFLIGHT_LOG%.
  exit /b 4
)

set "PG_SYNC_OK="
for /L %%I in (1,1,15) do (
  docker compose exec -T otp-postgres psql -U otp -d postgres -v ON_ERROR_STOP=1 < "%PG_SQL_FILE%" >> "%PG_PREFLIGHT_LOG%" 2>&1
  if not errorlevel 1 (
    set "PG_SYNC_OK=1"
    goto :sync_done
  )
  powershell -NoProfile -Command "Start-Sleep -Seconds 2" >nul 2>&1
)

:sync_done
del /q "%PG_SQL_FILE%" >nul 2>&1
if not defined PG_SYNC_OK (
  echo [ERROR] Could not synchronize the PostgreSQL role password after multiple attempts.
  echo [ACTION] The existing database volume was NOT deleted. See %PG_PREFLIGHT_LOG% for the real PostgreSQL error.
  echo [ACTION] Do not run RESET_DEMO.bat unless the data is disposable.
  echo.
  echo ===== POSTGRESQL PREFLIGHT LOG =====
  type "%PG_PREFLIGHT_LOG%"
  exit /b 5
)

rem Wait for the application database to exist and verify the exact TCP/password
rem authentication path used by SQLAlchemy. This closes the first-start race.
set "PG_VERIFY_OK="
for /L %%I in (1,1,30) do (
  docker compose exec -T -e PGPASSWORD=%OTP_DB_PASSWORD% otp-postgres psql -h 127.0.0.1 -U otp -d otp -v ON_ERROR_STOP=1 -tAc "SELECT 1" >> "%PG_PREFLIGHT_LOG%" 2>&1
  if not errorlevel 1 (
    set "PG_VERIFY_OK=1"
    goto :verify_done
  )
  powershell -NoProfile -Command "Start-Sleep -Seconds 2" >nul 2>&1
)

:verify_done
if not defined PG_VERIFY_OK (
  echo [ERROR] PostgreSQL password synchronized, but application-database TCP verification did not succeed within 60 seconds.
  echo [ACTION] See %PG_PREFLIGHT_LOG% and the PostgreSQL diagnostics below.
  docker compose logs --tail=120 otp-postgres
  exit /b 6
)

echo [OK] PostgreSQL credentials verified over the application TCP path.
exit /b 0
